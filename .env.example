# GLaDOS 签到脚本环境变量配置模板
# 复制此文件为 .env 并填写你的真实值

# pushplus秘钥（用于推送通知，可选）
PUSHPLUS_TOKEN=your_pushplus_token_here

# glados账号cookie（多个账号用 & 分隔，每个 cookie 结尾加 ;）
# 示例：koa:sess=xxx; koa:sess.sig=yyy;&koa:sess=aaa; koa:sess.sig=bbb;
GLADOS_COOKIE=your_glados_cookie_here

# webhook编码（可选）
WEBHOOK_CODE=your_webhook_code_here

# GLaDOS 站点域名（可选）
# 域名使用原则：这里手动填的优先尝试，全部不通时自动回退到脚本内置的镜像域名
# （space/network/rocks/one/cloud）。因此不填也能用——脚本会自动用第一个连通的，
# 应对默认域名需科学上网的情况。仅当你有专属镜像或想优先指定某域名时才配置。
# 可逗号分隔多个，结尾不要带斜杠。
# GLADOS_ORIGIN=https://your-mirror.example.com

# 签到接口 token（可选，默认 glados.cloud）
# 一般无需修改；当切换的镜像站要求不同 token 时再调整
GLADOS_TOKEN=glados.cloud
